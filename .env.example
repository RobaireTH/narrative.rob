NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

APP_STORAGE_MODE=memory
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=
FIRESTORE_NARRATIVES_COLLECTION=narratives
FIRESTORE_WORKSPACES_COLLECTION=workspaces
FIRESTORE_ORCHESTRATOR_SCHEDULES_COLLECTION=orchestrator_schedules
FIRESTORE_ORCHESTRATOR_RUNS_COLLECTION=orchestrator_runs
FIRESTORE_BAYSE_CONNECTIONS_COLLECTION=bayse_accounts
FIRESTORE_COMPILER_THREADS_COLLECTION=compiler_threads
GCS_WORKSPACE_BUCKET=
GCS_WORKSPACE_PREFIX=workspaces

REDIS_URL=

SECRET_MANAGER_BAYSE_SESSION_PREFIX=narrative-bayse-session
SECRET_MANAGER_BAYSE_API_KEY_PREFIX=narrative-bayse-api-key

BAYSE_BASE_URL=https://relay.bayse.markets
BAYSE_TIMEOUT_MS=15000
BAYSE_LOGIN_RATE_LIMIT_SECONDS=120

TRADING_MODE_DEFAULT=paper
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false

COMPILER_RUNTIME_MODE=disabled
COMPILER_MODEL_ID=claude-opus-4-7
COMPILER_REDIS_TTL_MINUTES=2880
ANTHROPIC_API_KEY=

ORCHESTRATOR_RUNTIME_MODE=disabled
ORCHESTRATOR_LOCK_TTL_SECONDS=900
ALLOW_NARRATIVE_IMPORT=false

INTERNAL_TOKEN=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_ORCHESTRATOR_QUEUE=
CLOUD_TASKS_ORCHESTRATOR_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
